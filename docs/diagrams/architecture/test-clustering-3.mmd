sequenceDiagram
    participant Dev as Developer
    participant Debug as "test_clustering_debug.py"
    participant Patch as "Monkey-patched LLM Client"
    participant Cluster as "cluster_modules()"

    Dev->>Debug: python3 test_clustering_debug.py
