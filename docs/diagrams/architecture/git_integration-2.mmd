sequenceDiagram
    participant CLI as "CLI Entry Point"
    participant GM as "GitManager"
    participant DocGen as "CLIDocumentationGenerator"
    participant Repo as "git.Repo"

    CLI->>GM: "GitManager(repo_path)"
    GM->>Repo: "git.Repo(repo_path)"
    CLI->>GM: "check_clean_working_directory()"
    GM-->>CLI: "(is_clean, status_message)"
    alt "Working directory dirty and not forced"
        GM-->>CLI: "raise RepositoryError"
    else "Clean or forced"
        CLI->>GM: "create_documentation_branch(force)"
        GM->>Repo: "create_head(branch_name)"
        GM->>Repo: "checkout()"
        GM-->>CLI: "branch_name"
        CLI->>DocGen: "generate()"
        DocGen-->>CLI: "DocumentationJob"
        CLI->>GM: "commit_documentation(docs_path, message)"
        GM->>Repo: "index.add([docs_path])"
        GM->>Repo: "index.commit(message)"
        GM-->>CLI: "commit_hash"
        CLI->>GM: "get_github_pr_url(branch_name)"
        GM-->>CLI: "pr_url or None"
    end
